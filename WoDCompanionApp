            { id: "bg_herd_5", name: "Rebaño", level: 5, source: "vampire", description: "Controlas un enorme rebaño de aproximadamente sesenta recipientes. Tu fuente de alimentación es abundante y está bien organizada.", system: [ "Tu rebaño es extraordinariamente numeroso. Puede estar compuesto por comunidades enteras o personas que voluntariamente mantienen una relación de alimentación contigo." ] },

            // --- CRIADOS ---
            { id: "bg_retainers_1", name: "Criados", level: 1, source: "vampire", description: "Tienes un sirviente o asistente leal que puede realizar tareas sencillas. Puede ser un ghoul, un criado mortal o alguien comprometido con tu servicio.", system: [ "Tienes un sirviente leal. Puede ser un mortal, un ghoul u otro subordinado que te presta servicios." ] },
            { id: "bg_retainers_2", name: "Criados", level: 2, source: "vampire", description: "Cuentas con uno o dos sirvientes competentes. Pueden ayudarte con tareas habituales, proteger tus intereses y mantener tus asuntos en orden.", system: [ "Cuentas con uno o dos subordinados que pueden ayudarte en tareas habituales. Su competencia y lealtad dependen de su naturaleza y de cómo los trates." ] },
            { id: "bg_retainers_3", name: "Criados", level: 3, source: "vampire", description: "Dispones de varios sirvientes leales o de un ghoul especialmente competente. Pueden ocuparse de tareas complejas y actuar en tu ausencia.", system: [ "Dispones de varios subordinados o de un servidor especialmente competente. Pueden actuar en tu nombre y ocuparse de asuntos que requieren discreción." ] },
            { id: "bg_retainers_4", name: "Criados", level: 4, source: "vampire", description: "Tienes un grupo de sirvientes experimentados y bien organizados. Algunos pueden ser ghouls con habilidades especiales y una considerable lealtad hacia ti.", system: [ "Tu grupo de subordinados posee experiencia y capacidades diversas. Puede incluir ghouls con habilidades especializadas." ] },
            { id: "bg_retainers_5", name: "Criados", level: 5, source: "vampire", description: "Posees una extensa red de sirvientes y ghouls altamente competentes. Pueden gestionar tus propiedades, protegerte y ejecutar operaciones complejas en tu nombre.", system: [ "Posees una red de subordinados que puede gestionar propiedades, proteger tus intereses y ejecutar operaciones complejas en tu nombre." ] },

            // --- MIEMBRO DE LA MANO NEGRA ---
            { id: "bg_black_hand_membership_1", name: "Miembro de la Mano Negra", level: 1, source: [ "vampire" ], description: "Eres un miembro raso de la Mano Negra. Puedes solicitar la ayuda de un miembro una vez por historia.", system: [ "La afiliación puede revelarse para añadir tu puntuación en este Trasfondo a las reservas de dados Sociales al tratar con otros Sabbat." ] },
            { id: "bg_black_hand_membership_2", name: "Miembro de la Mano Negra", level: 2, source: [ "vampire" ], description: "Eres conocido y respetado dentro de la Mano Negra. Puedes solicitar la ayuda de dos miembros una vez por historia.", system: [ "La afiliación puede revelarse para añadir tu puntuación en este Trasfondo a las reservas de dados Sociales al tratar con otros Sabbat." ] },
            { id: "bg_black_hand_membership_3", name: "Miembro de la Mano Negra", level: 3, source: [ "vampire" ], description: "Has ganado consideración dentro de la Mano Negra. Puedes solicitar la ayuda de cinco miembros una vez por historia.", system: [ "La afiliación puede revelarse para añadir tu puntuación en este Trasfondo a las reservas de dados Sociales al tratar con otros Sabbat." ] },
            { id: "bg_black_hand_membership_4", name: "Miembro de la Mano Negra", level: 4, source: [ "vampire" ], description: "Eres considerado un héroe entre los miembros de la Mano Negra. Puedes solicitar la ayuda de siete miembros dos veces por historia y dirigir grupos numerosos.", system: [ "La afiliación puede revelarse para añadir tu puntuación en este Trasfondo a las reservas de dados Sociales al tratar con otros Sabbat. El uso injustificado de tu influencia puede hacerte perder puntos en este Trasfondo." ] },
            { id: "bg_black_hand_membership_5", name: "Miembro de la Mano Negra", level: 5, source: [ "vampire" ], description: "Eres una figura legendaria dentro de la Mano Negra. Puedes solicitar la ayuda de doce miembros dos veces por historia, dirigir grupos numerosos y recibir consultas de los Serafines.", system: [ "La afiliación puede revelarse para añadir tu puntuación en este Trasfondo a las reservas de dados Sociales al tratar con otros Sabbat. El uso injustificado de tu influencia puede hacerte perder puntos en este Trasfondo." ] },

            // --- RITUALES ---
            { id: "bg_rituals_1", name: "Rituales", level: 1, source: [ "vampire" ], description: "Conoces algunos de los rituales auctoritas del Sabbat, a tu elección.", system: [ "Exclusivo de personajes Sabbat. Conoces algunos rituales auctoritas y puedes ejecutarlos." ] },
            { id: "bg_rituals_2", name: "Rituales", level: 2, source: [ "vampire" ], description: "Conoces algunos rituales auctoritas y varios rituales ignoblis, a tu elección.", system: [ "Exclusivo de personajes Sabbat. Conoces y puedes ejecutar algunos rituales auctoritas y varios rituales ignoblis." ] },
            { id: "bg_rituals_3", name: "Rituales", level: 3, source: [ "vampire" ], description: "Conoces todos los rituales auctoritas y varios rituales ignoblis. Puedes crear tus propios rituales ignoblis con tiempo y aprobación del Narrador.", system: [ "Exclusivo de personajes Sabbat. Puedes crear rituales ignoblis propios; el tiempo de desarrollo y sus efectos quedan a criterio del Narrador." ] },
            { id: "bg_rituals_4", name: "Rituales", level: 4, source: [ "vampire" ], description: "Conoces todos los rituales auctoritas y numerosos rituales ignoblis. También conoces las funciones de muchos rituales regionales y específicos de manada.", system: [ "Exclusivo de personajes Sabbat. Puedes crear rituales ignoblis propios con tiempo y aprobación del Narrador." ] },
            { id: "bg_rituals_5", name: "Rituales", level: 5, source: [ "vampire" ], description: "Conoces todos los rituales auctoritas y docenas de rituales ignoblis. Estás familiarizado con prácticamente todos los rituales regionales y específicos de manada conocidos.", system: [ "Exclusivo de personajes Sabbat. Puedes crear rituales ignoblis propios con tiempo y aprobación del Narrador." ] },

            // --- ESTATUS ---
            { id: "bg_status_1", name: "Estatus", level: 1, source: [ "core" ], description: "Eres reconocido como un miembro de cierta importancia dentro de tu sociedad y tienes una reputación favorable.", system: [] },
            { id: "bg_status_2", name: "Estatus", level: 2, source: [ "core" ], description: "Tienes una posición respetada y tus opiniones suelen recibir cierta consideración.", system: [] },
            { id: "bg_status_3", name: "Estatus", level: 3, source: [ "core" ], description: "Eres un miembro influyente de tu sociedad, con autoridad y reconocimiento entre tus pares.", system: [] },
            { id: "bg_status_4", name: "Estatus", level: 4, source: [ "core" ], description: "Ocupas una posición destacada y tu reputación te concede considerable respeto y autoridad.", system: [] },
            { id: "bg_status_5", name: "Estatus", level: 5, source: [ "core" ], description: "Eres una figura de enorme prestigio, cuya autoridad y reputación se extienden ampliamente dentro de tu sociedad.", system: [] },

            // --- DEN REALM ---
            { id: "bg_den_realm_1", name: "Den Realm", level: 1, source: [ "bastet" ], description: "Posees un pequeño refugio en la Umbra, adecuado para ti y algunos visitantes.", system: [ "Trasfondo exclusivo de Bastet. Representa un refugio personal en la Umbra. Su tamaño, seguridad y características aumentan con la puntuación." ] },
            { id: "bg_den_realm_2", name: "Den Realm", level: 2, source: [ "bastet" ], description: "Tu refugio umbral puede alojar a un pequeño grupo y cuenta con algunas comodidades.", system: [ "Trasfondo exclusivo de Bastet. Tu refugio ofrece mayor espacio y protección que uno básico." ] },
            { id: "bg_den_realm_3", name: "Den Realm", level: 3, source: [ "bastet" ], description: "Posees un refugio considerable, con espacio para varios compañeros y recursos útiles.", system: [ "Trasfondo exclusivo de Bastet. Tu refugio tiene instalaciones y defensas considerables." ] },
            { id: "bg_den_realm_4", name: "Den Realm", level: 4, source: [ "bastet" ], description: "Tu refugio es amplio, seguro y cuenta con características umbrales especiales.", system: [ "Trasfondo exclusivo de Bastet. Tu refugio es difícil de encontrar y ofrece protección y comodidades importantes." ] },
            { id: "bg_den_realm_5", name: "Den Realm", level: 5, source: [ "bastet" ], description: "Posees un refugio umbral extraordinario, con gran extensión, protección y recursos.", system: [ "Trasfondo exclusivo de Bastet. Tu refugio es una propiedad umbral excepcional, con características extraordinarias determinadas junto al Narrador." ] },

            // --- CLARO UMBRAL ---
            { id: "bg_umbral_glade_1", name: "Umbral Glade", level: 1, source: [ "gurahl" ], description: "Tienes acceso a un pequeño claro espiritual en la Umbra.", system: [ "Trasfondo exclusivo de Gurahl. Representa un claro umbral vinculado a la naturaleza y a los espíritus. Su extensión y características dependen de la puntuación." ] },
            { id: "bg_umbral_glade_2", name: "Umbral Glade", level: 2, source: [ "gurahl" ], description: "Tu claro espiritual posee una extensión moderada y puede servir de refugio.", system: [ "Trasfondo exclusivo de Gurahl. Tu claro ofrece un espacio espiritual más amplio y mejores condiciones para descansar o interactuar con espíritus." ] },
            { id: "bg_umbral_glade_3", name: "Umbral Glade", level: 3, source: [ "gurahl" ], description: "Posees un claro importante, con una presencia espiritual reconocible.", system: [ "Trasfondo exclusivo de Gurahl. El claro tiene una conexión espiritual considerable y puede albergar a otros cambiaformas." ] },
            { id: "bg_umbral_glade_4", name: "Umbral Glade", level: 4, source: [ "gurahl" ], description: "Tu claro es extenso y posee una fuerte conexión con los espíritus de la naturaleza.", system: [ "Trasfondo exclusivo de Gurahl. Tu claro es un lugar espiritual importante, con características y habitantes sobrenaturales determinados con el Narrador." ] },
            { id: "bg_umbral_glade_5", name: "Umbral Glade", level: 5, source: [ "gurahl" ], description: "Posees un santuario natural extraordinario en la Umbra.", system: [ "Trasfondo exclusivo de Gurahl. Tu claro es un santuario espiritual excepcional, con una conexión profunda con la naturaleza." ] },

            // --- MNESIS ---
            { id: "bg_mnesis_1", name: "Mnesis", level: 1, source: [ "mokole" ], description: "Puedes acceder ocasionalmente a fragmentos de los recuerdos ancestrales de tu especie.", system: [ "Trasfondo exclusivo de Mokolé. Permite acceder a la memoria ancestral de los Mokolé, recuperando recuerdos de épocas pasadas." ] },
            { id: "bg_mnesis_2", name: "Mnesis", level: 2, source: [ "mokole" ], description: "Puedes recuperar recuerdos ancestrales con cierta frecuencia y claridad.", system: [ "Trasfondo exclusivo de Mokolé. Tu conexión con la memoria ancestral es más fuerte y permite recuperar recuerdos más detallados." ] },
            { id: "bg_mnesis_3", name: "Mnesis", level: 3, source: [ "mokole" ], description: "Tienes acceso a recuerdos antiguos y conocimientos transmitidos a través de generaciones.", system: [ "Trasfondo exclusivo de Mokolé. Puedes consultar recuerdos ancestrales profundos, aunque su interpretación puede requerir tiradas." ] },
            { id: "bg_mnesis_4", name: "Mnesis", level: 4, source: [ "mokole" ], description: "Tu memoria ancestral es extensa y contiene recuerdos de acontecimientos muy antiguos.", system: [ "Trasfondo exclusivo de Mokolé. Tu acceso a la memoria ancestral es considerable y puede revelar información de épocas remotas." ] },
            { id: "bg_mnesis_5", name: "Mnesis", level: 5, source: [ "mokole" ], description: "Posees una conexión excepcional con la memoria colectiva de los Mokolé.", system: [ "Trasfondo exclusivo de Mokolé. Puedes acceder a recuerdos ancestrales extraordinariamente antiguos y detallados." ] },

            // --- WALLOW ---
            { id: "bg_wallow_1", name: "Wallow", level: 1, source: [ "mokole" ], description: "Tienes acceso a un pequeño territorio acuático que puedes utilizar como refugio.", system: [ "Trasfondo exclusivo de Mokolé. Representa un territorio acuático propio. Su tamaño, recursos y seguridad dependen de la puntuación." ] },
            { id: "bg_wallow_2", name: "Wallow", level: 2, source: [ "mokole" ], description: "Tu territorio acuático es más amplio y cuenta con recursos naturales.", system: [ "Trasfondo exclusivo de Mokolé. Tu territorio ofrece mejores condiciones de refugio y acceso a recursos." ] },
            { id: "bg_wallow_3", name: "Wallow", level: 3, source: [ "mokole" ], description: "Posees un territorio considerable, adecuado para albergar a otros Mokolé.", system: [ "Trasfondo exclusivo de Mokolé. Tu territorio posee recursos y espacio suficientes para un grupo." ] },
            { id: "bg_wallow_4", name: "Wallow", level: 4, source: [ "mokole" ], description: "Tu territorio es extenso y cuenta con abundantes recursos y lugares protegidos.", system: [ "Trasfondo exclusivo de Mokolé. Tu territorio es importante y ofrece buenas condiciones de protección y sustento." ] },
            { id: "bg_wallow_5", name: "Wallow", level: 5, source: [ "mokole" ], description: "Controlas un territorio acuático excepcional, rico en recursos y difícil de invadir.", system: [ "Trasfondo exclusivo de Mokolé. Tu territorio es extraordinario por su extensión, recursos y seguridad." ] },

            // --- ANANTA ---
            { id: "bg_ananta_1", name: "Ananta", level: 1, source: [ "nagah" ], description: "Posees una conexión limitada con la red de refugios y recursos secretos de los Nagah.", system: [ "Trasfondo exclusivo de Nagah. Representa el acceso a la infraestructura secreta de los Nagah y a sus recursos ocultos." ] },
            { id: "bg_ananta_2", name: "Ananta", level: 2, source: [ "nagah" ], description: "Tienes acceso a varios recursos y refugios de la red secreta Nagah.", system: [ "Trasfondo exclusivo de Nagah. Tu acceso a la red Ananta es mayor y permite obtener más apoyo." ] },
            { id: "bg_ananta_3", name: "Ananta", level: 3, source: [ "nagah" ], description: "Eres un miembro bien conectado de la red secreta y puedes recurrir a sus recursos.", system: [ "Trasfondo exclusivo de Nagah. Tu posición dentro de la red facilita el acceso a refugios, información y apoyo." ] },
            { id: "bg_ananta_4", name: "Ananta", level: 4, source: [ "nagah" ], description: "Posees una posición importante dentro de la red y acceso a recursos considerables.", system: [ "Trasfondo exclusivo de Nagah. Tu influencia permite coordinar recursos y obtener apoyo de distintos miembros." ] },
            { id: "bg_ananta_5", name: "Ananta", level: 5, source: [ "nagah" ], description: "Eres una figura de gran importancia dentro de la red secreta Nagah.", system: [ "Trasfondo exclusivo de Nagah. Tu posición te proporciona acceso excepcional a la red y sus recursos." ] },

            // --- SECRETOS ---
            { id: "bg_secrets_1", name: "Secretos", level: 1, source: [ "corax", "nuwisha", "bastet", "ananasi", "kitsune", "nagah" ], description: "Conoces un secreto menor relacionado con el mundo sobrenatural.", system: [ "Trasfondo compartido de cambiaformas. Representa información secreta que puede resultar útil. La importancia y alcance del secreto aumentan con la puntuación." ] },
            { id: "bg_secrets_2", name: "Secretos", level: 2, source: [ "corax", "nuwisha", "bastet", "ananasi", "kitsune", "nagah" ], description: "Conoces información privada que podría resultar valiosa para otros cambiaformas.", system: [ "Trasfondo compartido de cambiaformas. El secreto tiene relevancia para una comunidad o grupo sobrenatural." ] },
            { id: "bg_secrets_3", name: "Secretos", level: 3, source: [ "corax", "nuwisha", "bastet", "ananasi", "kitsune", "nagah" ], description: "Posees información importante sobre individuos, organizaciones o acontecimientos sobrenaturales.", system: [ "Trasfondo compartido de cambiaformas. El secreto puede afectar a grupos o asuntos importantes del mundo sobrenatural." ] },
            { id: "bg_secrets_4", name: "Secretos", level: 4, source: [ "corax", "nuwisha", "bastet", "ananasi", "kitsune", "nagah" ], description: "Conoces secretos peligrosos que podrían alterar el equilibrio de poder entre distintas facciones.", system: [ "Trasfondo compartido de cambiaformas. La información tiene gran importancia y puede comprometer a figuras u organizaciones poderosas." ] },
            { id: "bg_secrets_5", name: "Secretos", level: 5, source: [ "corax", "nuwisha", "bastet", "ananasi", "kitsune", "nagah" ], description: "Posees conocimientos extraordinarios sobre secretos de enorme importancia para el mundo sobrenatural.", system: [ "Trasfondo compartido de cambiaformas. El secreto puede tener consecuencias trascendentales y atraer la atención de entidades poderosas." ] },

            // --- MAPA UMBRAL ---
            { id: "bg_umbral_maps_1", name: "Mapa Umbral", level: 1, source: [ "core" ], description: "Posees mapas básicos de una pequeña región de la Umbra.", system: [ "Trasfondo compartido de cambiaformas. Representa el conocimiento cartográfico de rutas y regiones umbrales." ] },
            { id: "bg_umbral_maps_2", name: "Mapa Umbral", level: 2, source: [ "core" ], description: "Tus mapas cubren varias regiones y contienen rutas conocidas.", system: [ "Trasfondo compartido de cambiaformas. Tus mapas proporcionan información sobre más rutas y lugares de la Umbra." ] },
            { id: "bg_umbral_maps_3", name: "Mapa Umbral", level: 3, source: [ "core" ], description: "Posees mapas detallados de regiones importantes y rutas poco conocidas.", system: [ "Trasfondo compartido de cambiaformas. Tu conocimiento cartográfico incluye rutas y lugares que no son conocidos por todos." ] },
            { id: "bg_umbral_maps_4", name: "Mapa Umbral", level: 4, source: [ "core" ], description: "Tus mapas cubren extensas regiones de la Umbra e incluyen rutas peligrosas y ocultas.", system: [ "Trasfondo compartido de cambiaformas. Tus mapas son extensos y contienen información valiosa sobre territorios umbrales." ] },
            { id: "bg_umbral_maps_5", name: "Mapa Umbral", level: 5, source: [ "core" ], description: "Posees una colección extraordinaria de mapas umbrales, con rutas y lugares de difícil acceso.", system: [ "Trasfondo compartido de cambiaformas. Tu colección es excepcional y puede incluir rutas secretas y regiones remotas." ] },

            // --- ANCESTROS ---
            { id: "bg_ancestors_1", name: "Ancestros", level: 1, source: [ "garou", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea" ], description: "Mantienes una conexión limitada con tus antepasados y puedes recurrir ocasionalmente a sus recuerdos y conocimientos.", system: [ "Puedes gastar un punto de Fuerza de Voluntad y tirar tu puntuación de Ancestros para obtener dados adicionales en una tirada de una Habilidad. Cada éxito proporciona un dado adicional." ] },
            { id: "bg_ancestors_2", name: "Ancestros", level: 2, source: [ "garou", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea" ], description: "Tu conexión ancestral es más fuerte y puedes recurrir a una mayor cantidad de conocimientos heredados.", system: [ "Puedes gastar un punto de Fuerza de Voluntad y tirar Ancestros para obtener dados adicionales en una tirada de una Habilidad. Cada éxito proporciona un dado adicional." ] },
            { id: "bg_ancestors_3", name: "Ancestros", level: 3, source: [ "garou", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea" ], description: "Posees una conexión importante con tus antepasados y puedes recurrir a sus experiencias.", system: [ "Puedes gastar un punto de Fuerza de Voluntad y tirar Ancestros para obtener dados adicionales en una tirada de una Habilidad. Cada éxito proporciona un dado adicional." ] },
            { id: "bg_ancestors_4", name: "Ancestros", level: 4, source: [ "garou", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea" ], description: "Tu vínculo con tus antepasados es extraordinariamente fuerte.", system: [ "Puedes recurrir a una extensa memoria ancestral mediante las reglas de Ancestros." ] },
            { id: "bg_ancestors_5", name: "Ancestros", level: 5, source: [ "garou", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea" ], description: "Tu conexión ancestral alcanza un nivel excepcional y representa una extensa herencia espiritual.", system: [ "Tu conexión con la memoria ancestral es extraordinaria. Puedes recurrir a ella mediante las reglas de Ancestros." ] },

            // --- PURA RAZA ---
            { id: "bg_pure_breed_1", name: "Pura Raza", level: 1, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "kitsune", "nagah" ], description: "Tu linaje es reconocible y posee ciertas características tradicionales de tu raza.", system: [ "Representa la pureza y reputación de tu linaje Garou. Puede influir en las interacciones sociales con otros Garou." ] },
            { id: "bg_pure_breed_2", name: "Pura Raza", level: 2, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "kitsune", "nagah" ], description: "Tu linaje es conocido y respetado por sus características y tradiciones.", system: [ "Tu linaje es reconocible entre los Garou y puede proporcionar ventajas sociales en determinadas interacciones." ] },
            { id: "bg_pure_breed_3", name: "Pura Raza", level: 3, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "kitsune", "nagah" ], description: "Procedas de un linaje importante, reconocido por sus hazañas y tradiciones.", system: [ "Tu linaje posee una reputación considerable. Pura Raza puede contribuir a las tiradas sociales y al reconocimiento entre los Garou." ] },
            { id: "bg_pure_breed_4", name: "Pura Raza", level: 4, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "kitsune", "nagah" ], description: "Tu linaje es excepcional y está asociado con figuras importantes de tu raza.", system: [ "Tu linaje es muy respetado y puede influir considerablemente en las interacciones sociales con otros Garou." ] },
            { id: "bg_pure_breed_5", name: "Pura Raza", level: 5, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "kitsune", "nagah" ], description: "Tu linaje es legendario y representa una de las herencias más prestigiosas de tu raza.", system: [ "Tu linaje es extraordinariamente puro y respetado. Puede tener una influencia muy importante en las relaciones sociales entre Garou." ] },

            // --- PARENTELA ---
            { id: "bg_kinfolk_1", name: "Parentela", level: 1, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Mantienes contacto con unos pocos miembros de tu familia o comunidad que conocen tu verdadera naturaleza.", system: [ "Representa una pequeña red de familiares y aliados Parentela. Pueden reconocer a los Garou y, generalmente, no sufren el Delirio.", ] },
            { id: "bg_kinfolk_2", name: "Parentela", level: 2, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Posees una pequeña red de familiares y aliados que pueden proporcionarte ayuda ocasional.", system: [ "Tienes una red de Parentela que pueden ofrecer refugio, información y asistencia." ] },
            { id: "bg_kinfolk_3", name: "Parentela", level: 3, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Posees una red considerable de familiares y aliados, repartidos en una comunidad.", system: [ "Tu red de Parentela puede proporcionar información, refugio y asistencia en distintas circunstancias." ] },
            { id: "bg_kinfolk_4", name: "Parentela", level: 4, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu red de familiares y aliados es extensa y cuenta con miembros influyentes.", system: [ "Tu red de Parentela es extensa y puede ofrecer asistencia, refugio e información en una región amplia." ] },
            { id: "bg_kinfolk_5", name: "Parentela", level: 5, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Posees una red extraordinaria de familiares y aliados, con presencia en numerosas comunidades.", system: [ "Tu red de Parentela es extraordinariamente extensa y puede ofrecer apoyo en una gran cantidad de lugares." ] },

            // --- FETICHE ---
            { id: "bg_fetish_1", name: "Fetiche", level: 1, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Posees un fetiche sencillo, un objeto que contiene un espíritu vinculado y un poder sobrenatural.", system: [ "Representa un objeto que contiene un espíritu vinculado. El nivel del fetiche determina su poder y sus capacidades." ] },
            { id: "bg_fetish_2", name: "Fetiche", level: 2, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Posees un fetiche de poder moderado, con un espíritu capaz de proporcionar una utilidad considerable.", system: [ "Representa un fetiche de nivel 2. Sus capacidades dependen del espíritu vinculado y de su descripción." ] },
            { id: "bg_fetish_3", name: "Fetiche", level: 3, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Posees un fetiche poderoso, con capacidades sobrenaturales importantes.", system: [ "Representa un fetiche de nivel 3. Sus capacidades dependen del espíritu vinculado y de su descripción." ] },
            { id: "bg_fetish_4", name: "Fetiche", level: 4, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Posees un fetiche excepcional, con un espíritu poderoso y capacidades extraordinarias.", system: [ "Representa un fetiche de nivel 4. Sus capacidades dependen del espíritu vinculado y de su descripción." ] },
            { id: "bg_fetish_5", name: "Fetiche", level: 5, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Posees un fetiche legendario, vinculado a un espíritu de enorme poder.", system: [ "Representa un fetiche de nivel 5. Sus capacidades dependen del espíritu vinculado y de su descripción." ] },

            // --- RITOS ---
            { id: "bg_rites_1", name: "Rituales", level: 1, source: [ "garou" ], description: "Conoces algunos ritos Garou de nivel uno.", system: [ "Permite conocer ritos Garou. La puntuación determina el nivel máximo de los ritos que puedes aprender: 1 punto permite ritos de nivel uno." ] },
            { id: "bg_rites_2", name: "Rituales", level: 2, source: [ "garou" ], description: "Conoces ritos Garou de nivel uno y dos.", system: [ "Puedes aprender ritos Garou de hasta nivel dos." ] },
            { id: "bg_rites_3", name: "Rituales", level: 3, source: [ "garou" ], description: "Conoces ritos Garou de hasta nivel tres.", system: [ "Puedes aprender ritos Garou de hasta nivel tres." ] },
            { id: "bg_rites_4", name: "Rituales", level: 4, source: [ "garou" ], description: "Conoces ritos Garou de hasta nivel cuatro.", system: [ "Puedes aprender ritos Garou de hasta nivel cuatro." ] },
            { id: "bg_rites_5", name: "Rituales", level: 5, source: [ "garou" ], description: "Conoces ritos Garou de hasta nivel cinco.", system: [ "Puedes aprender ritos Garou de hasta nivel cinco." ] },

            // --- SPIRIT HERITAGE ---
            { id: "bg_spirit_heritage_1", name: "Spirit Heritage", level: 1, source: [ "garou" ], description: "Posees una conexión espiritual con una familia o clase específica de espíritus.", system: [ "Representa la afinidad con una categoría de espíritus. Puede influir en las interacciones con ellos y en determinadas circunstancias espirituales." ] },
            { id: "bg_spirit_heritage_2", name: "Spirit Heritage", level: 2, source: [ "garou" ], description: "Tu conexión con una clase de espíritus es reconocible y puede facilitar tus relaciones con ellos.", system: [ "Tu afinidad espiritual es mayor y puede facilitar las interacciones con la categoría de espíritus elegida." ] },
            { id: "bg_spirit_heritage_3", name: "Spirit Heritage", level: 3, source: [ "garou" ], description: "Posees una conexión importante con una familia de espíritus y eres reconocido por ellos.", system: [ "Tu conexión espiritual es considerable y puede proporcionar ventajas en las interacciones con los espíritus correspondientes." ] },
            { id: "bg_spirit_heritage_4", name: "Spirit Heritage", level: 4, source: [ "garou" ], description: "Tu conexión espiritual es excepcional y tienes una relación estrecha con los espíritus de tu herencia.", system: [ "Tu afinidad con la categoría de espíritus elegida es excepcional." ] },
            { id: "bg_spirit_heritage_5", name: "Spirit Heritage", level: 5, source: [ "garou" ], description: "Tu herencia espiritual es extraordinaria y tu conexión con esos espíritus es profunda.", system: [ "Tu conexión con la categoría de espíritus elegida es extraordinaria y puede influir profundamente en tus interacciones con ellos." ] },

            // --- TOTEM ---
            { id: "bg_totem_1", name: "Totem", level: 1, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Mantienes un vínculo con un espíritu tótem que puede ofrecerte orientación y ayuda limitada.", system: [ "Representa el vínculo espiritual de una manada con su tótem. Los puntos invertidos determinan el poder y los beneficios disponibles para la manada." ] },
            { id: "bg_totem_2", name: "Totem", level: 2, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu vínculo con el tótem es más fuerte y permite recibir mayores beneficios espirituales.", system: [ "La inversión de puntos en el tótem determina sus poderes y beneficios para la manada." ] },
            { id: "bg_totem_3", name: "Totem", level: 3, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu vínculo espiritual es considerable y el tótem puede ofrecer poderes importantes.", system: [ "El tótem dispone de una cantidad considerable de puntos para adquirir poderes y beneficios para la manada." ] },
            { id: "bg_totem_4", name: "Totem", level: 4, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Posees una relación excepcional con un espíritu tótem poderoso.", system: [ "El tótem posee numerosos puntos para adquirir poderes y beneficios para la manada." ] },
            { id: "bg_totem_5", name: "Totem", level: 5, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu vínculo con un espíritu tótem es extraordinario y representa una relación espiritual de enorme importancia.", system: [ "El tótem dispone de una gran cantidad de puntos para adquirir poderes y beneficios para la manada." ] },

            // --- FATE ---
            { id: "bg_fate_1", name: "Destino", level: 1, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Existe una profecía o destino relacionado contigo, aunque sus consecuencias todavía son inciertas.", system: [ "Representa una profecía o destino importante. Puede proporcionar protección o ayuda en momentos relacionados con tu destino, según las reglas de Destino." ] },
            { id: "bg_fate_2", name: "Destino", level: 2, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu destino está ligado a acontecimientos importantes que comienzan a manifestarse.", system: [ "Tu destino puede intervenir en situaciones importantes y proporcionar protección de acuerdo con las reglas de Destino." ] },
            { id: "bg_fate_3", name: "Destino", level: 3, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu destino está claramente marcado y puede influir en acontecimientos importantes.", system: [ "Tu destino tiene una importancia considerable y puede proporcionar ayuda cuando se manifiesta." ] },
            { id: "bg_fate_4", name: "Destino", level: 4, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu destino parece estar vinculado a acontecimientos de gran importancia para tu raza.", system: [ "Tu destino es excepcionalmente importante y puede intervenir en acontecimientos trascendentales." ] },
            { id: "bg_fate_5", name: "Destino", level: 5, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu destino es extraordinario y puede estar ligado al futuro de tu raza o del mundo.", system: [ "Tu destino tiene una importancia extraordinaria. Sus consecuencias y la protección que proporciona quedan sujetas a las reglas de Destino y al Narrador." ] },

            // --- NUMEN ---
            { id: "bg_numen_1", name: "Numen", level: 1, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tienes un espíritu familiar o compañero que te ofrece ayuda limitada.", system: [ "Representa un espíritu compañero o familiar. Sus capacidades y servicios dependen de su naturaleza y de la puntuación del Trasfondo." ] },
            { id: "bg_numen_2", name: "Numen", level: 2, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu espíritu familiar posee algunas capacidades útiles y puede ayudarte con regularidad.", system: [ "Tu espíritu compañero puede ofrecer asistencia más significativa y dispone de mayores capacidades." ] },
            { id: "bg_numen_3", name: "Numen", level: 3, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu espíritu familiar es un aliado competente y puede realizar tareas complejas.", system: [ "Tu espíritu compañero posee capacidades considerables y puede ayudarte en diversas situaciones." ] },
            { id: "bg_numen_4", name: "Numen", level: 4, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu espíritu familiar es poderoso y puede ofrecer asistencia sobrenatural importante.", system: [ "Tu espíritu compañero posee capacidades excepcionales." ] },
            { id: "bg_numen_5", name: "Numen", level: 5, source: [ "garou", "bastet", "gurahl", "ajaba", "corax", "mokolé", "ratkin", "rokea", "ananasi", "kitsune", "nagah" ], description: "Tu espíritu familiar es extraordinariamente poderoso y constituye un aliado sobrenatural excepcional.", system: [ "Tu espíritu compañero posee capacidades extraordinarias. Sus poderes específicos deben establecerse junto al Narrador." ] },

            // --- ARCANE ---
            { id: "bg_arcane_1", name: "Arcano", level: 1, source: [ "mage" ], description: "Tu presencia es difícil de recordar y pasas relativamente desapercibido.", system: [ "Cada punto de Arcano dificulta que otras personas te presten atención, recuerden tu presencia o encuentren información sobre ti." ] },
            { id: "bg_arcane_2", name: "Arcano", level: 2, source: [ "mage" ], description: "Las personas suelen olvidarse de ti poco después de conocerte.", system: [ "Tu naturaleza arcana dificulta notablemente que otros te recuerden o te identifiquen." ] },
            { id: "bg_arcane_3", name: "Arcano", level: 3, source: [ "mage" ], description: "Puedes moverte entre multitudes sin llamar demasiado la atención y resulta difícil seguir tu rastro.", system: [ "Tu presencia sobrenaturalmente discreta dificulta que te localicen, recuerden o relacionen con determinados acontecimientos." ] },
            { id: "bg_arcane_4", name: "Arcano", level: 4, source: [ "mage" ], description: "Incluso quienes interactúan contigo pueden tener dificultades para recordar detalles sobre ti.", system: [ "Tu naturaleza arcana hace extremadamente difícil que otros te identifiquen o reconstruyan tus movimientos." ] },
            { id: "bg_arcane_5", name: "Arcano", level: 5, source: [ "mage" ], description: "Eres prácticamente un desconocido para el mundo; tu presencia y tus rastros tienden a desaparecer de la memoria de los demás.", system: [ "Tu presencia resulta extraordinariamente difícil de percibir, recordar o rastrear. Arcano no te vuelve invisible ni elimina automáticamente registros físicos o digitales." ] },

            // --- AVATAR ---
            { id: "bg_avatar_1", name: "Avatar", level: 1, source: [ "mage" ], description: "Tu Avatar tiene una presencia débil y apenas se manifiesta en tu vida cotidiana.", system: [ "Representa la fuerza y presencia de tu Avatar, el alma despierta que te permite practicar magia." ] },
            { id: "bg_avatar_2", name: "Avatar", level: 2, source: [ "mage" ], description: "Tu Avatar posee una presencia moderada y puede manifestarse ocasionalmente.", system: [ "Representa una conexión más fuerte con tu Avatar y su capacidad para interactuar contigo." ] },
            { id: "bg_avatar_3", name: "Avatar", level: 3, source: [ "mage" ], description: "Tu Avatar es una presencia importante en tu vida y puede comunicarse contigo de distintas maneras.", system: [ "Tu Avatar posee una fuerza considerable. Su naturaleza, personalidad y manifestaciones dependen de su Esencia." ] },
            { id: "bg_avatar_4", name: "Avatar", level: 4, source: [ "mage" ], description: "Tu Avatar es poderoso y su presencia resulta difícil de ignorar.", system: [ "Tu Avatar posee una fuerza excepcional y puede manifestarse de manera significativa durante experiencias místicas." ] },
            { id: "bg_avatar_5", name: "Avatar", level: 5, source: [ "mage" ], description: "Tu Avatar es extraordinariamente poderoso y constituye una presencia dominante en tu existencia.", system: [ "Representa un Avatar de enorme fuerza espiritual. Su personalidad, Esencia y relación contigo son elementos importantes del personaje." ] },

            // --- DESTINY ---
            { id: "bg_destiny_1", name: "Destino", level: 1, source: [ "mage" ], description: "Tu vida parece estar ligada a un destino especial, aunque sus señales son débiles.", system: [ "Representa una profecía o destino personal. Puede proporcionar protección y orientación en circunstancias relacionadas con él, pero también implica obligaciones." ] },
            { id: "bg_destiny_2", name: "Destino", level: 2, source: [ "mage" ], description: "Existen señales claras de que estás destinado a cumplir un propósito importante.", system: [ "Tu destino puede intervenir en momentos importantes y ofrecer protección de acuerdo con las reglas de Destino." ] },
            { id: "bg_destiny_3", name: "Destino", level: 3, source: [ "mage" ], description: "Tu destino está claramente definido y parece estar relacionado con acontecimientos importantes.", system: [ "Tu destino tiene una influencia considerable en tu historia y puede proporcionar protección cuando sus circunstancias se manifiestan." ] },
            { id: "bg_destiny_4", name: "Destino", level: 4, source: [ "mage" ], description: "Tu destino está ligado a acontecimientos trascendentales y puede afectar a muchas personas.", system: [ "Tu destino posee una importancia excepcional. Sus beneficios y obligaciones deben interpretarse en relación con la profecía." ] },
            { id: "bg_destiny_5", name: "Destino", level: 5, source: [ "mage" ], description: "Tu destino es extraordinario y podría influir en el futuro de la realidad o de la humanidad.", system: [ "Representa un destino de importancia extraordinaria. Puede ofrecer una protección considerable, pero su cumplimiento puede exigir grandes sacrificios." ] },

            // --- FAMILIAR ---
            { id: "bg_familiar_1", name: "Familiar", level: 1, source: [ "mage" ], description: "Tienes un pequeño espíritu familiar que te acompaña y ofrece ayuda limitada.", system: [ "Representa un espíritu vinculado a ti mediante un pacto o relación mágica. Su forma, personalidad y capacidades dependen de su naturaleza." ] },
            { id: "bg_familiar_2", name: "Familiar", level: 2, source: [ "mage" ], description: "Tu familiar posee algunas capacidades útiles y puede ayudarte en tareas sencillas.", system: [ "Tu familiar es un espíritu con capacidades moderadas. Puede ayudarte y participar en actividades mágicas de acuerdo con sus poderes." ] },
            { id: "bg_familiar_3", name: "Familiar", level: 3, source: [ "mage" ], description: "Tu familiar es un aliado espiritual competente y posee capacidades sobrenaturales considerables.", system: [ "Tu familiar posee una conexión significativa contigo y puede ofrecer asistencia sobrenatural y mágica." ] },
            { id: "bg_familiar_4", name: "Familiar", level: 4, source: [ "mage" ], description: "Tu familiar es un espíritu poderoso y un compañero importante en tus actividades mágicas.", system: [ "Tu familiar posee capacidades excepcionales y puede ser un aliado importante en tus prácticas mágicas." ] },
            { id: "bg_familiar_5", name: "Familiar", level: 5, source: [ "mage" ], description: "Tu familiar es un espíritu extraordinariamente poderoso, con una relación muy estrecha contigo.", system: [ "Tu familiar es un aliado espiritual excepcional. Sus poderes concretos, naturaleza y obligaciones dependen del pacto y de las reglas correspondientes." ] },

            // --- NODE ---
            { id: "bg_node_1", name: "Nodo", level: 1, source: [ "mage" ], description: "Tienes acceso a un pequeño Nodo que produce una cantidad limitada de Quintaesencia.", system: [ "Representa el acceso a un lugar donde se concentra Quintaesencia. Su puntuación determina la capacidad y producción del Nodo." ] },
            { id: "bg_node_2", name: "Nodo", level: 2, source: [ "mage" ], description: "Posees acceso a un Nodo de capacidad moderada.", system: [ "Tu Nodo produce y almacena más Quintaesencia que uno básico." ] },
            { id: "bg_node_3", name: "Nodo", level: 3, source: [ "mage" ], description: "Tienes acceso a un Nodo importante, con una reserva considerable de Quintaesencia.", system: [ "Tu Nodo es una fuente considerable de Quintaesencia y puede atraer la atención de otros magos." ] },
            { id: "bg_node_4", name: "Nodo", level: 4, source: [ "mage" ], description: "Controlas o tienes acceso a un Nodo poderoso, con una producción notable de Quintaesencia.", system: [ "Tu Nodo es una fuente importante de energía mágica y puede ser un recurso estratégico para una cábala o una facción." ] },
            { id: "bg_node_5", name: "Nodo", level: 5, source: [ "mage" ], description: "Tienes acceso a un Nodo extraordinariamente poderoso, con una enorme concentración de Quintaesencia.", system: [ "Tu Nodo es una fuente excepcional de Quintaesencia. Su ubicación, producción, resonancia y posibles habitantes espirituales deben establecerse con el Narrador." ] },

            // --- SANCTUM ---
            { id: "bg_sanctum_1", name: "Sanctum", level: 1, source: [ "mage" ], description: "Posees un pequeño espacio privado donde puedes estudiar y practicar tu magia.", system: [ "Representa un lugar preparado y armonizado con tu Focus. Sus características pueden facilitar tus prácticas mágicas cuando se cumplen las condiciones apropiadas." ] },
            { id: "bg_sanctum_2", name: "Sanctum", level: 2, source: [ "mage" ], description: "Tu sanctum cuenta con instalaciones y herramientas adecuadas para tus prácticas.", system: [ "Tu sanctum dispone de mejores instalaciones y recursos para realizar investigaciones y trabajos mágicos." ] },
            { id: "bg_sanctum_3", name: "Sanctum", level: 3, source: [ "mage" ], description: "Posees un sanctum bien equipado, con espacio para investigaciones y prácticas complejas.", system: [ "Tu sanctum es un espacio mágico importante, preparado para investigaciones y prácticas especializadas." ] },
            { id: "bg_sanctum_4", name: "Sanctum", level: 4, source: [ "mage" ], description: "Tu sanctum es amplio, está muy bien equipado y puede albergar a otros magos.", system: [ "Tu sanctum posee instalaciones excepcionales y puede servir como centro de operaciones para una cábala." ] },
            { id: "bg_sanctum_5", name: "Sanctum", level: 5, source: [ "mage" ], description: "Posees un sanctum extraordinario, con instalaciones, protección y recursos mágicos excepcionales.", system: [ "Tu sanctum es un lugar mágico de gran importancia. Sus defensas, instalaciones y características especiales deben definirse con el Narrador." ] },

            // --- WONDER ---
            { id: "bg_wonder_1", name: "Maravilla", level: 1, source: [ "mage" ], description: "Posees un objeto mágico sencillo con un efecto sobrenatural limitado.", system: [ "Representa un objeto mágico permanente, como un Talismán o un Dispositivo. Sus efectos, coste y capacidades dependen de su construcción." ] },
            { id: "bg_wonder_2", name: "Maravilla", level: 2, source: [ "mage" ], description: "Posees un objeto mágico con un efecto útil y una capacidad sobrenatural moderada.", system: [ "Tu objeto mágico posee capacidades moderadas. Sus efectos concretos dependen de las Esferas y de su construcción." ] },
            { id: "bg_wonder_3", name: "Maravilla", level: 3, source: [ "mage" ], description: "Posees un objeto mágico poderoso, capaz de producir efectos sobrenaturales importantes.", system: [ "Tu Maravilla posee capacidades considerables. Su funcionamiento, efectos y limitaciones dependen de su diseño mágico." ] },
            { id: "bg_wonder_4", name: "Maravilla", level: 4, source: [ "mage" ], description: "Posees un objeto mágico excepcional, con efectos complejos o de gran alcance.", system: [ "Tu Maravilla es un objeto de gran poder, con efectos mágicos importantes y una construcción avanzada." ] },
            { id: "bg_wonder_5", name: "Maravilla", level: 5, source: [ "mage" ], description: "Posees un objeto mágico extraordinario, con capacidades que pueden cambiar el curso de acontecimientos importantes.", system: [ "Tu Maravilla es un objeto mágico excepcional. Sus efectos, Esferas, capacidades y limitaciones deben detallarse individualmente." ] }
            
