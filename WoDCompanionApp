            { id: "chains_of_the_emperor001", source: ["wraith"], rank: 1, name: "Resplandor", description: "El guardia intensifica el brillo sobrenatural de sus colores hasta deslumbrar a sus enemigos cercanos.", system: [{ rank: 1, description: "Sistema: Tarda tres turnos en alcanzar su brillo máximo. Todos los que estén cerca deben superar una tirada de Resistencia a dificultad 7 o quedan cegados. Los ataques contra el guardia aumentan su dificultad en 1 durante los dos primeros turnos y en 2 por cada turno posterior. Cuesta 1 punto de Pathos y dura cinco turnos. Una pifia ciega al guardia durante un turno por cada pifia." }] },
            { id: "chains_of_the_emperor002", source: ["wraith"], rank: 2, name: "Esposas", description: "El guardia crea un par de esposas a partir de su propio Corpus para inmovilizar las manos o los pies de un adversario que ya esté inmovilizado.", system: [{ rank: 2, description: "Sistema: Tira Destreza + Cadenas del Emperador a dificultad 5. Colocar las esposas requiere un turno y cuesta 2 puntos de Corpus y 1 punto de Pathos. Solo otro guardia puede retirarlas, salvo que sean desgarradas mediante Moliate. Un fallo provoca igualmente la pérdida de 2 puntos de Corpus; una pifia convierte esa pérdida en daño agravado." }] },
            { id: "chains_of_the_emperor003", source: ["wraith"], rank: 3, name: "Celada", description: "El guardia impide que otro wraith utilice Argos, evitando que escape o se desplace mediante este Arcanos.", system: [{ rank: 3, description: "Sistema: El guardia debe estar en contacto físico con el wraith objetivo; el contacto puede mantenerse mediante unas Esposas. El objetivo debe superar una tirada enfrentada de Fuerza + Pelea contra el guardia. Si pierde, no puede utilizar Argos mientras se mantenga el efecto de la Celada." }] },
            { id: "chains_of_the_emperor004", source: ["wraith"], rank: 4, name: "Lazo", description: "El guardia arroja una parte de su propio Corpus contra un objetivo en movimiento, formando un lazo que puede atraparlo a distancia.", system: [{ rank: 4, description: "Sistema: El objetivo debe encontrarse a un máximo de 50 pies. Cuesta 1 punto de Pathos y 2 puntos de Corpus. Tira Destreza + Cadenas del Emperador a dificultad 7. Cada resultado de 1 inflige al guardia un nivel de daño normal." }] },
            { id: "chains_of_the_emperor005", source: ["wraith"], rank: 5, name: "Red", description: "El guardia lanza una red de fibras adhesivas que puede atrapar a varios adversarios simultáneamente.", system: [{ rank: 5, description: "Sistema: Gasta 3 puntos de Pathos para crear una red de 12 pies de diámetro, que puede lanzarse hasta 20 pies. Tira Destreza + Cadenas del Emperador a dificultad 6. Las víctimas alcanzadas quedan completamente inmovilizadas. Romper una fibra requiere una tirada de Fuerza + Pelea; escapar por completo exige entre 3 y 6 éxitos, según determine el Narrador. El Jade Verdadero puede cortar la red, pero el Jade Blanco se rompe al intentarlo. Una pifia inflige al guardia 3 niveles de daño agravado y 2 puntos temporales de Angustia." }] }
