        const leechcraft = [
            { id: "leechcraft000", source: ["wraith"], rank: 0, name: "Leechcraft", description: "Arcanos Oscuro utilizado por los Espectros durante el Cuarto Gran Maelstrom. Permite manipular Corpus, Angustia y las fuerzas del Olvido, tanto para dañar a otros como para recuperar la propia esencia. Es una perversión de Usury.", system: [{ rank: 0, description: "Sistema: Oscuridad Visible permite medir la intensidad del Olvido presente en otro ser. La mecánica detallada de la tirada y la dificultad en el sistema clásico no están confirmadas." }] },
