            { id: "kinesis001", source: ["wraith"], rank: 1, name: "Atar", description: "El wraith provoca que los mecanismos de un dispositivo se bloqueen. Relojes, motores y otros aparatos con piezas móviles dejan de funcionar temporalmente.", system: [{ rank: 1, description: "Sistema: La mecánica detallada de la tirada, dificultad y duración en el sistema clásico no está confirmada. No afecta a dispositivos que carecen de piezas móviles. Para volver a funcionar, la máquina debe ser reiniciada; los mecanismos delicados pueden necesitar además que alguien los sacuda." }] },
            { id: "kinesis002", source: ["wraith"], rank: 2, name: "Relicario", description: "El wraith imbuye un objeto inanimado con Pathos para fortalecerlo y protegerlo de la destrucción.", system: [{ rank: 2, description: "Sistema: La mecánica detallada de la tirada y la dificultad en el sistema clásico no están confirmadas. El poder transfiere Pathos al objeto; cada punto invertido protege al objeto frente a un incidente que normalmente lo destruiría. El Pathos se disipa después de cumplir su función." }] },
            { id: "kinesis003", source: ["wraith"], rank: 3, name: "Descontrol", description: "El wraith toma el control de una máquina de las Tierras de la Piel y manipula su funcionamiento. Puede hacer que un vehículo acelere, se detenga o se mueva erráticamente, aunque no puede dirigirlo con precisión.", system: [{ rank: 3, description: "Sistema: La mecánica detallada de la tirada, dificultad y número de acciones en el sistema clásico no están confirmadas. El poder permite manipular el funcionamiento general del dispositivo, pero no controlar directamente su dirección." }] },
            { id: "kinesis004", source: ["wraith"], rank: 4, name: "Reclamar", description: "El wraith utiliza una máquina u objeto como cuerpo temporal, habitándolo y actuando a través de él.", system: [{ rank: 4, description: "Sistema: La mecánica detallada de la tirada, dificultad, duración y resistencia del objeto en el sistema clásico no están confirmadas. Su efecto es equivalente al Arte Reclamar de Inhabit." }] },
            { id: "kinesis005", source: ["wraith"], rank: 5, name: "El Agarre de Ludd", description: "El wraith fuerza a un dispositivo a funcionar al revés, provocando que sus mecanismos se destruyan a sí mismos.", system: [{ rank: 5, description: "Sistema: La mecánica detallada de la tirada, dificultad y daño causado en el sistema clásico no están confirmadas. El poder hace que el dispositivo invierta su funcionamiento hasta comenzar a desarmarse o destruirse." }] }
