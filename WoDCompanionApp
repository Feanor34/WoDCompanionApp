<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>World of Darkness Companion</title>
        <style>
        :root {
            --bg: #111211;
            --sidebar: #181a18;
            --panel: #1d201d;
            --panel-light: #252925;
            --border: #383e38;
            --text: #e5e5df;
            --muted: #a1a69e;
            --accent: #a6b49b;
            --accent-dark: #687760;
            --red: #9b4545;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: Georgia, "Times New Roman", serif;
            min-height: 100vh;
        }
        button { font: inherit; }
        .app {
            display: flex;
            min-height: 100vh;
        }
        /* SIDEBAR */
        .sidebar {
            width: 250px;
            flex-shrink: 0;
            background: var(--sidebar);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 25px 16px;
        }
        .brand {
            padding: 8px 10px 30px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 25px;
        }
        .brand-mark {
            color: var(--accent);
            font-size: 30px;
            letter-spacing: 5px;
            text-transform: uppercase;
        }
        .brand-subtitle {
            color: var(--muted);
            font: 10px Arial, sans-serif;
            letter-spacing: 3px;
            margin-top: 5px;
        }
        .nav-label {
            color: #777e75;
            font: 10px Arial, sans-serif;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 0 12px;
            margin: 18px 0 9px;
        }
        .nav-button {
            width: 100%;
            background: transparent;
            color: var(--muted);
            border: 1px solid transparent;
            padding: 12px;
            text-align: left;
            cursor: pointer;
            border-radius: 4px;
            margin-bottom: 4px;
            transition: .2s;
        }
        .nav-button:hover {
            background: var(--panel);
            color: var(--text);
        }
        .nav-button.active {
            background: var(--panel-light);
            color: var(--text);
            border-color: var(--border);
            border-left: 3px solid var(--accent-dark);
        }
        .sidebar-footer {
            margin-top: auto;
            border-top: 1px solid var(--border);
            padding: 18px 10px 0;
            color: #777e75;
            font: 10px Arial, sans-serif;
            line-height: 1.7;
        }
        /* MAIN */
        .main {
            flex: 1;
            min-width: 0;
        }
        .topbar {
            height: 64px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
            background: rgba(24,26,24,.55);
        }
        .topbar-title {
            color: var(--muted);
            font: 10px Arial, sans-serif;
            letter-spacing: 2px;
        }
        .topbar-status {
            color: var(--muted);
            font: 11px Arial, sans-serif;
        }
        .status-dot {
            display: inline-block;
            height: 7px;
            width: 7px;
            background: #8caa7b;
            border-radius: 50%;
            margin-right: 7px;
        }
        .content {
            max-width: 1450px;
            padding: 42px 4.5%;
            margin: 0 auto;
        }
        .page { display: none; }
        .page.active { display: block; }
        .eyebrow {
            color: var(--accent);
            font: 10px Arial, sans-serif;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        h1 {
            font-size: 43px;
            font-weight: normal;
            margin: 12px 0 10px;
        }
        h2 {
            font-weight: normal;
            font-size: 25px;
        }
        h3 {
            font-weight: normal;
            font-size: 19px;
            margin: 0 0 10px;
        }
        .subtitle {
            color: var(--muted);
            font-size: 15px;
            line-height: 1.7;
            max-width: 750px;
            margin: 0;
        }
        .section-heading {
            display: flex;
            align-items: end;
            justify-content: space-between;
            margin: 35px 0 16px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 12px;
        }
        .section-heading h2 { margin: 0; font-size: 23px; }
        .section-heading span {
            color: var(--muted);
            font: 10px Arial, sans-serif;
            letter-spacing: 1px;
        }
        /* CARDS */
        .card-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 15px;
        }
        .card {
            background: linear-gradient(145deg, var(--panel-light), var(--panel));
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 22px;
            min-height: 170px;
        }
        .card-icon {
            color: var(--accent);
            font-size: 23px;
            margin-bottom: 18px;
        }
        .card p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.6;
            margin: 0;
        }
        .card-link {
            display: inline-block;
            color: var(--accent);
            font: 10px Arial, sans-serif;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-top: 18px;
        }
        /* HOME HERO */
        .hero {
            min-height: 280px;
            border: 1px solid var(--border);
            background:
            linear-gradient(90deg, rgba(17,18,17,.98), rgba(17,18,17,.72)),
            radial-gradient(ellipse at 80% 45%, #465044 0%, #20251f 38%, #151715 75%);
            padding: 42px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }
        .hero:after {
            content: "M";
            position: absolute;
            right: 7%;
            top: -45px;
            color: rgba(190,205,180,.055);
            font-size: 330px;
            line-height: 1;
            pointer-events: none;
        }
        .hero h1 { font-size: 48px; max-width: 650px; }
        .hero p {
            color: #b4b9b0;
            max-width: 600px;
            line-height: 1.8;
            font-size: 14px;
        }
        /* TABS */
        .tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            border-bottom: 1px solid var(--border);
            margin: 30px 0 22px;
        }
        .tab-button {
            background: transparent;
            color: var(--muted);
            border: 1px solid transparent;
            border-bottom: 0;
            padding: 12px 17px;
            cursor: pointer;
            font-size: 13px;
        }
        .tab-button:hover { color: var(--text); }
        .tab-button.active {
            color: var(--text);
            background: var(--panel);
            border-color: var(--border);
        }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }
        .info-panel {
            background: var(--panel);
            border: 1px solid var(--border);
            padding: 25px;
            border-radius: 4px;
        }
        .info-panel p {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.8;
        }
        .rule-list {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }
        .rule-item {
            padding: 15px;
            background: var(--panel-light);
            border: 1px solid var(--border);
        }
        .rule-item strong { display: block; margin-bottom: 6px; font-weight: normal; }
        .rule-item span { color: var(--muted); font-size: 12px; }
        /* LINE CARDS */
        .line-card {
            background: var(--panel);
            border: 1px solid var(--border);
            width: 70%;
            min-height: 164px;
            padding: 17px;
            justify-self: center;
            position: relative;
        }
        .line-card:before {
            content: "";
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 3px;
            background: var(--line-color, var(--accent-dark));
        }
        .line-card .edition {
            color: var(--muted);
            font: 9px Arial, sans-serif;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .line-card h3 { margin-top: 14px; }
        .line-card p {
            color: var(--muted);
            font-size: 11px;
            line-height: 1.5;
        }

        .line-card {
            width: 100%;
            text-align: left;
            color: var(--text);
            font-family: inherit;
            cursor: pointer;
            transition: border-color 0.2s, background 0.2s;
        }

        .line-card:hover {
            border-color: var(--line-color);
        }

        .line-card.active {
            border-color: var(--line-color);
            background: var(--panel-light);
        }

        .line-card:focus-visible {
            outline: 2px solid var(--line-color);
            outline-offset: 3px;
        }
        
        #lineInfoSelectors {
            margin-top: 15px;
        }

        #lineContent {
            margin-top: 30px;
        }

        /* PLACEHOLDERS */
        .placeholder {
            margin-top: 25px;
            padding: 55px 25px;
            text-align: center;
            border: 1px dashed var(--border);
            background: rgba(29,32,29,.45);
        }
        .placeholder .symbol { color: var(--accent); font-size: 30px; }
        .placeholder p {
            color: var(--muted);
            max-width: 520px;
            margin: 10px auto 0;
            line-height: 1.7;
            font-size: 13px;
        }
        @media (max-width: 1000px) {
            .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 700px) {
            .app { display: block; }
            .sidebar { width: 100%; padding: 12px; }
            .brand { padding: 5px 8px 14px; margin-bottom: 12px; }
            .brand-mark { font-size: 23px; }
            .nav-label, .sidebar-footer { display: none; }
            .sidebar nav { display: flex; overflow-x: auto; gap: 4px; }
            .nav-button { width: auto; white-space: nowrap; padding: 10px; font-size: 12px; }
            .topbar { padding: 0 16px; height: 48px; }
            .content { padding: 27px 16px; }
            h1 { font-size: 34px; }
            .hero { padding: 25px; min-height: 250px; }
            .hero h1 { font-size: 36px; }
            .card-grid, .rule-list { grid-template-columns: 1fr; }
        }
        </style>
    </head>
