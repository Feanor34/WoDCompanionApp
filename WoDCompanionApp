            { id: "way_of_the_artisan000", source: ["wraith"], rank: 0, name: "Senda del Artesano", description: "Este Arcanos permite trabajar el Jade Verdadero, el Jade Blanco y las reliquias. El artesano comprende que los objetos del Inframundo están hechos de almas y puede moldear esa esencia.", system: [{ rank: 0, description: "Sistema: Escuchar el Relato del Jade (Hear Jade's Tale) es la capacidad básica del Arcanos. Permite percibir la historia y naturaleza espiritual del jade. La referencia consultada no especifica una tirada ni una dificultad para esta capacidad." }] },
            { id: "way_of_the_artisan001", source: ["wraith"], rank: 1, name: "Moldear Jade Verdadero", description: "El artesano utiliza materia prima y tiempo para crear un objeto sencillo a partir de Jade Verdadero.", system: [{ rank: 1, description: "Sistema: Tira Astucia + Expresión a dificultad 6. El número de éxitos necesarios depende de la complejidad del objeto que deseas crear. Un fallo significa que el trabajo no tiene éxito, pero el material permanece intacto y puede utilizarse para otra creación. Una pifia destruye el Jade Verdadero y lo vuelve inservible." }] },
            { id: "way_of_the_artisan002", source: ["wraith"], rank: 2, name: "Trabajar Jade Blanco", description: "El artesano trabaja el Jade Blanco de la misma manera que el Jade Verdadero. También puede trabajar el Corpus preparado de un kuei.", system: [{ rank: 2, description: "Sistema: Utiliza la misma tirada y las mismas reglas que Moldear Jade Verdadero: Astucia + Expresión a dificultad 6. Para crear un objeto se necesita tres veces más Jade Blanco que Jade Verdadero. El Corpus de un kuei debe estar preparado antes de poder trabajarse. Un fallo no destruye el material; una pifia lo arruina." }] },
            { id: "way_of_the_artisan003", source: ["wraith"], rank: 3, name: "Reelaborar Reliquias", description: "El artesano modifica objetos que no están hechos de jade, alterando su forma e incluso la naturaleza del material del que están compuestos.", system: [{ rank: 3, description: "Sistema: Tira Destreza + Senda del Artesano a dificultad 7 para cambiar la forma de una reliquia. Modificar el material del que está hecha requiere al menos 3 éxitos en una tirada a dificultad 8. Un fallo deja la reliquia sin cambios. Una pifia la destruye funcionalmente." }] },
            { id: "way_of_the_artisan004", source: ["wraith"], rank: 4, name: "Fortalecer Jade", description: "El artesano imbuye objetos de jade con Pathos o con uno de los Arcanos que conoce. Un objeto puede almacenar un único Arcanos y el Pathos necesario para alimentarlo.", system: [{ rank: 4, description: "Sistema: Gasta 3 puntos de Pathos más la cantidad que quieras invertir en el objeto y tira Astucia + Artesanía. La dificultad es 5 para Jade Verdadero y 7 para Jade Blanco. Solo puedes imbuir el objeto con tu propio Pathos y tus propios Arcanos. El Jade Verdadero conserva el poder indefinidamente; el Jade Blanco lo pierde después de tantos meses como el doble de los éxitos obtenidos. Imbuir un poder de Arcanos cuesta además 1 punto de Fuerza de Voluntad y 1 punto de Pathos por nivel del poder. Un fallo deja el jade sin poderes. Una pifia drena 3 puntos adicionales de Pathos, hasta un mínimo de 1, y concede 1 punto temporal de Angustia." }] },
            { id: "way_of_the_artisan005", source: ["wraith"], rank: 5, name: "Crear Jade Blanco", description: "El artesano transforma un alma cautiva en Jade Blanco. Antes de comenzar, debe quebrar por completo el espíritu de la víctima.", system: [{ rank: 5, description: "Sistema: La víctima debe tener Fuerza de Voluntad y Pathos en 0. El proceso requiere tres días completos de trabajo. Tira Manipulación + Artesanía a dificultad 6 y acumula 10 éxitos durante esos tres días. Cada Corpus transformado produce aproximadamente tres libras de Jade Blanco. Antes de comenzar, el artesano decide si el jade será duro y rígido, adecuado para armas y armaduras, o blando y flexible, adecuado para muebles y prendas; la elección no puede cambiarse. El proceso cuesta 1 punto de Pathos por día y concede 1 punto temporal de Angustia. Una pifia transforma al alma cautiva en un kuei." }] }
