            { id: "way_of_the_soul002", source: ["wraith"], rank: 2, name: "Anular Espinas", description: "El wraith impide temporalmente que su p’o utilice una de sus Espinas.", system: [{ rank: 2, description: "Sistema: Gasta 1 punto de Pathos y realiza una tirada enfrentada de Resistencia + Meditación contra la Angustia temporal del p’o. Si tienes éxito, eliges una Espina que el p’o no podrá utilizar durante media hora por éxito obtenido. Una pifia concede al p’o 1 punto temporal de Angustia." }] },
            { id: "way_of_the_soul003", source: ["wraith"], rank: 3, name: "Inducir Pasiones Elevadas", description: "El wraith introduce una de sus propias Pasiones en su p’o, sustituyendo temporalmente una de sus Pasiones Oscuras.", system: [{ rank: 3, description: "Sistema: Gasta 2 puntos de Pathos y tira Manipulación + Meditación a dificultad igual a la Angustia temporal del p’o +2, con un máximo de 10. Cada éxito permite que tu Pasión sustituya una Pasión Oscura elegida durante un día. Una pifia concede al wraith 2 puntos temporales de Angustia." }] },
            { id: "way_of_the_soul004", source: ["wraith"], rank: 4, name: "Alterar el Comportamiento", description: "El wraith persuade a su p’o para que adopte un nuevo Arquetipo de Sombra o incluso la Naturaleza de la Psique, modificando temporalmente sus prioridades y comportamiento.", system: [{ rank: 4, description: "Sistema: Gasta 3 puntos de Pathos y tira Manipulación + Persuasión a dificultad igual a la Angustia temporal del p’o +4, con un máximo de 10. Cada éxito mantiene el nuevo Arquetipo durante una semana. Una pifia concede al p’o 4 puntos temporales de Angustia. Incluso un fallo normal concede 1 punto temporal de Angustia al p’o." }] },
            { id: "way_of_the_soul005", source: ["wraith"], rank: 5, name: "Paz Interior", description: "El wraith une su hun y su p’o, permitiendo que ambos aspectos de su alma actúen como una entidad unificada. Durante esta unión puede aprovechar tanto sus Pasiones como sus Pasiones Oscuras y utilizar los poderes de ambas partes.", system: [{ rank: 5, description: "Sistema: Realiza una tirada enfrentada de Fuerza de Voluntad contra la Angustia del p’o. Si tienes éxito, obtienes Pathos tanto de tus Pasiones como de las Pasiones Oscuras del p’o, y puedes utilizar tus propios Arcanos y las Espinas del p’o, gastando Pathos y Angustia según corresponda. La unión termina cuando se agota toda la Angustia temporal del p’o o transcurren 24 horas, lo que ocurra primero. Durante este estado ninguno de los dos aspectos controla completamente al wraith. Un fallo despierta la furia del p’o; una pifia le concede el control inmediato y 3 puntos temporales adicionales de Angustia." }] }
        ];

        // --- MISCELLANEOUS ARCANOI ---
       // --- BEHEST ---
        const behest = [
            { id: "behest000", source: ["wraith"], rank: 0, name: "Instancia", description: "Este Arcanos permite a los Moriman del Bosque de los Fantasmas establecer vínculos sobrenaturales con otros wraiths, rastrearlos y observar sus experiencias. Se divide en dos sendas: la Mano Derecha, dedicada a la percepción y la adivinación, y la Mano Izquierda, centrada en la manipulación.", system: [{ rank: 0, description: "Sistema: Vínculo (Link) permite percibir lugares, individuos y objetos relacionados con un wraith objetivo. El usuario exhala una nube de humo que forma imágenes de los lugares y objetos importantes para el objetivo. La información no revela distancias ni escalas. La mecánica detallada de la versión de dados no está especificada en la referencia consultada." }] },
            { id: "behest001", source: ["wraith"], rank: 1, name: "Hurgar", description: "El Moriman entra en trance y percibe fragmentos de las experiencias recientes de otro wraith. No descubre sus pensamientos, sino el entorno que lo rodeaba.", system: [{ rank: 1, description: "Sistema: Gasta 1 punto de Pathos y realiza una tirada enfrentada de Carisma contra el objetivo. Si tiene éxito, percibe el estado de ánimo reciente del objetivo. Puede gastar un punto de Rasgo Mental para recibir impresiones de uno de sus sentidos sobre el entorno. Al activar tres o más sentidos obtiene una reconstrucción vívida del lugar. Puede gastar otro punto de Rasgo Mental para descubrir cuándo tuvo lugar la experiencia." }] },
            { id: "behest002", source: ["wraith"], rank: 2, name: "Rastrear", description: "El Moriman sigue el rastro espiritual de otro wraith a partir de un objeto que le pertenezca o de un lugar que haya abandonado recientemente.", system: [{ rank: 2, description: "Sistema: El usuario debe sujetar un objeto del objetivo o encontrarse en un lugar que este haya abandonado recientemente. Gasta 1 punto de Corpus, sufre 1 nivel de daño y realiza una tirada de Inteligencia enfrentada. Con éxito, descubre la dirección en la que se encuentra el objetivo. Puede gastar un punto de Rasgo Mental para conocer su distancia aproximada o dos para determinar su ubicación precisa. Si utiliza dos puntos para obtener la ubicación precisa, el objetivo puede realizar una tirada enfrentada de Inteligencia para advertir que está siendo rastreado. El rastro permanece visible durante una hora por cada punto de Behest que posea el usuario." }] },
            { id: "behest003", source: ["wraith"], rank: 3, name: "Escrutar", description: "El Moriman observa lo que otro wraith está viendo en ese momento. Pertenece a la Mano Derecha de Behest.", system: [{ rank: 3, description: "Sistema: Requiere localizar previamente al objetivo mediante Vínculo o Rastrear. La mecánica detallada de la tirada y su dificultad en el sistema clásico no están especificadas en la referencia consultada." }] },
            { id: "behest004", source: ["wraith"], rank: 4, name: "Adivinar", description: "El Moriman contempla el futuro de sí mismo o de otro wraith. Pertenece a la Mano Derecha de Behest.", system: [{ rank: 4, description: "Sistema: La mecánica detallada de la tirada, dificultad y alcance de la visión futura no están especificadas en la referencia consultada." }] },
            { id: "behest005", source: ["wraith"], rank: 3, name: "Sacudir", description: "El Moriman fuerza pequeños movimientos físicos en otro wraith mediante la manipulación de su Corpus. Pertenece a la Mano Izquierda de Behest.", system: [{ rank: 3, description: "Sistema: Requiere haber localizado previamente al objetivo mediante Escrutar. La mecánica detallada de la tirada y sus límites en el sistema clásico no están especificadas en la referencia consultada." }] },
            { id: "behest006", source: ["wraith"], rank: 4, name: "Murmurar", description: "El Moriman utiliza la voz de otro wraith para hablar a través de él. Pertenece a la Mano Izquierda de Behest.", system: [{ rank: 4, description: "Sistema: Requiere haber localizado previamente al objetivo mediante Escrutar. La mecánica detallada de la tirada y sus límites en el sistema clásico no están especificadas en la referencia consultada." }] },
            { id: "behest007", source: ["wraith"], rank: 5, name: "Virar", description: "El Moriman obtiene un control similar al de Puppetry sobre otro wraith, dirigiendo sus acciones y movimientos. Es la culminación de la Mano Izquierda de Behest.", system: [{ rank: 5, description: "Sistema: Requiere haber localizado previamente al objetivo mediante Escrutar. La mecánica detallada de la tirada, resistencia y duración en el sistema clásico no están especificadas en la referencia consultada." }] }
        ];

        // --- CONNAISSANCE ---
        const connaissance = [
            { id: "connaissance000", source: ["wraith"], rank: 0, name: "Conocimiento", description: "Este Arcanos pertenece a los Serviteurs de las Mirrorlands y permite utilizar la propia Sombra como aliada para detectar las fuerzas del Olvido, comunicarse con los Espectros y manipularlos. Los practicantes deben establecer un vínculo estrecho con su Sombra. Las Artes Comunes están disponibles para los Serviteurs; las Artes de Iniciado requieren lealtad a Les Mystères.", system: [{ rank: 0, description: "Sistema: Regular Mait' Tête permite que la Sombra tome el control del Serviteur durante un periodo acordado, manteniendo el Serviteur consciencia de sus acciones. Tira Astucia + Connaissance contra una dificultad igual a la Angustia permanente de la Sombra. Los éxitos determinan cuánto tiempo puede permanecer al mando. Un éxito permite una invitación de duración indefinida; cinco éxitos permiten expulsarla voluntariamente después del primer turno sin oposición. Para expulsarla antes, realiza una tirada enfrentada de Angustia temporal de la Sombra contra Fuerza de Voluntad permanente del Serviteur. Si el Serviteur vence, la Sombra es expulsada y pierde 1 punto de Angustia temporal. Cada intento de expulsión anticipada cuesta 1 punto de Fuerza de Voluntad." }] },
            { id: "connaissance001", source: ["wraith"], rank: 1, name: "Los Ojos del Cazador", description: "El Serviteur toma prestados los ojos de su Sombra para detectar la presencia y concentración del Olvido. Puede localizar Espectros, Sombras dominantes, Nihils y otros Serviteurs.", system: [{ rank: 1, description: "Sistema: Tira Astucia + Connaissance a dificultad 8. Un éxito permite detectar las presencias indicadas. El área explorada depende de los éxitos: 1 éxito, 10 yardas cuadradas; 2 éxitos, 50 yardas cuadradas; 3 éxitos, 100 yardas cuadradas; 4 éxitos, 500 yardas cuadradas; 5 o más éxitos, una milla cuadrada. Si se utiliza para orientarse en el Abismo junto con Argos, los éxitos obtenidos reducen la dificultad de las tiradas posteriores de Ojo para el Clima o Lector de Tormentas en esa misma cantidad, hasta un mínimo de 2." }] },
            { id: "connaissance002", source: ["wraith"], rank: 1, name: "Convocar Baka", description: "El Serviteur llama a un Espectro para que acuda a su presencia. El convocado utiliza el medio más rápido disponible, pero no tiene por qué ser amistoso.", system: [{ rank: 1, description: "Sistema: Tira Manipulación + Connaissance a dificultad 6 y gasta 1 punto de Pathos. Cada éxito convoca a un Espectro. No puedes elegir un Espectro concreto; los convocados pueden atacar al Serviteur o responder a su llamada según sus propios intereses." }] },
            { id: "connaissance003", source: ["wraith"], rank: 2, name: "La Lengua", description: "El Serviteur utiliza su Sombra como intérprete para comunicarse en la lengua secreta de los Baka, los Loa y Les Mystères.", system: [{ rank: 2, description: "Sistema: Tira Astucia + Connaissance a dificultad 8. Con un éxito, puedes comunicarte con cualquier espíritu del Olvido, incluidos Espectros, wraiths guiados por sus Sombras y Sombras inactivas. Los éxitos determinan la duración: 1 éxito, un turno; 5 éxitos, una semana. Si obtienes una pifia o termina el efecto, tu Sombra puede falsear deliberadamente la traducción." }] },
            { id: "connaissance004", source: ["wraith"], rank: 2, name: "Repeler Baka", description: "El Serviteur intimida a los Espectros aparentando ser más poderoso y peligroso de lo que realmente es, obligándolos a huir.", system: [{ rank: 2, description: "Sistema: Tira Manipulación + Connaissance a dificultad 8. Cada éxito obliga a un Espectro presente en las inmediaciones a huir inmediatamente. El efecto dura una escena; después, los Espectros afectados pueden regresar acompañados de refuerzos. Utilizar esta Arte concede 2 puntos temporales de Angustia." }] },
            { id: "connaissance005", source: ["wraith"], rank: 3, name: "Fortalecer a los Caballos", description: "El Serviteur comparte parte de su poder con un mortal, normalmente un familiar vivo o un houngan fiel. El receptor obtiene capacidades sobrenaturales temporales.", system: [{ rank: 3, description: "Sistema: Toca al mortal, gasta 5 puntos de Pathos y 5 puntos temporales de Fuerza de Voluntad. Tira Manipulación + Connaissance a dificultad 8, reducida en 1 si estás montando al mortal mediante Skinriding o si realizas el poder durante una ceremonia. Con éxito, el mortal obtiene el primer nivel de un Arcanos que poseas y que afecte al mundo de los vivos, o 1 punto de Potencia, Celeridad o Fortaleza. El mortal puede poseer tantos Arcanos como su Fuerza de Voluntad permanente; superar ese límite destruye su cordura. Utiliza Fuerza de Voluntad temporal para activar las capacidades recibidas. No funciona sobre criaturas sobrenaturales." }] },
            { id: "connaissance006", source: ["wraith"], rank: 3, name: "Compromiso", description: "El Serviteur establece una conexión telepática con la Mente Colmena del Olvido para transmitir pensamientos y órdenes a uno o varios Espectros cercanos. Las órdenes se implantan de manera tan sutil que los objetivos creen que son ideas propias.", system: [{ rank: 3, description: "Sistema: Tira Manipulación + Connaissance a dificultad 5 + número de objetivos, hasta un máximo de cinco. Los éxitos determinan el grado de control: 1 éxito permite sugerencias que coincidan con las inclinaciones del Espectro; 5 éxitos pueden convencerlo de destruir su propio Corpus. Cuesta 1 punto de Pathos y concede 1 punto temporal de Angustia por cada objetivo controlado." }] },
            { id: "connaissance007", source: ["wraith"], rank: 4, name: "Recuperar del Fondo de las Aguas", description: "El Serviteur realiza un ritual con un houngan mortal para crear un govi, un nuevo Grillete que representa el vínculo entre el wraith y sus familiares vivos.", system: [{ rank: 4, description: "Sistema: Requiere un ritual nocturno completo en el que el houngan prepara una vasija de barro y el Serviteur permanece en contacto con ella. Gasta 5 puntos de Pathos y 3 puntos de Fuerza de Voluntad. Tira Astucia + Connaissance a dificultad 7. Cada éxito proporciona 1 punto de puntuación al nuevo Grillete. Un wraith con otros Grilletes solo puede tener un govi de hasta 5 puntos; si el govi es su único Grillete, puede alcanzar 10 puntos. Ningún wraith puede tener más de un govi. Mientras exista, el houngan o los familiares custodios pueden gastar 1 punto de Fuerza de Voluntad para comunicarse con el Serviteur durante el resto de la escena, sin importar la distancia. Ambos deben hablar en voz alta." }] },
            { id: "connaissance008", source: ["wraith"], rank: 4, name: "Consultar a Les Mystères", description: "El Loa accede temporalmente al vasto conocimiento acumulado por Les Mystères, obteniendo habilidades o respuestas a preguntas especialmente difíciles.", system: [{ rank: 4, description: "Sistema: Tira Astucia + Connaissance a dificultad 8. Puedes distribuir los éxitos como puntos adicionales entre Talentos, Habilidades y Conocimientos que ya poseas durante el resto de la escena, sin superar 5 puntos en ninguna capacidad. Alternativamente, puedes gastar todos los éxitos para formular una pregunta profunda al Narrador, quien debe responder con la verdad y el detalle que permitan los éxitos obtenidos. Solo puede utilizarse una vez por escena. Cuesta 2 puntos de Fuerza de Voluntad y concede 1 punto temporal de Angustia por cada éxito obtenido." }] },
            { id: "connaissance009", source: ["wraith"], rank: 5, name: "Bondad Abismal", description: "El Serviteur establece un pacto con Les Mystères que le permite convocar una Reliquia o Artefacto de la Isla Bajo el Mar a cambio de realizar un servicio para ellos.", system: [{ rank: 5, description: "Sistema: Tira Astucia + Connaissance a dificultad 8. Gasta 1 punto de Pathos y 1 punto temporal de Fuerza de Voluntad por cada nivel de la Reliquia o Artefacto deseado. Se abre un espejo ovalado cuya superficie parece mercurio, permitiéndote atravesarlo y recoger el objeto. El Narrador debe aprobar el objeto convocado. El uso concede 1 punto temporal de Angustia y te obliga a realizar un servicio para Les Mystères acorde al valor del objeto dentro de un año y un día. Incumplir el pacto provoca su ira." }] },
            { id: "connaissance010", source: ["wraith"], rank: 5, name: "Atrapar Baka", description: "El Serviteur somete a un Espectro mediante un duelo de voluntades. Una vez vencido, el Baka queda paralizado y sigue al Serviteur mientras este permanezca cerca.", system: [{ rank: 5, description: "Sistema: Tira Manipulación + Connaissance en una acción enfrentada contra el Ser del objetivo. Si obtienes éxitos iguales o superiores a su puntuación de Ser, queda incapaz de actuar o defenderse durante tantos turnos como tu Fuerza de Voluntad actual. El Baka permanece consciente y puede intentar escapar una vez por turno gastando 1 punto de Angustia y repitiendo la tirada enfrentada. Si el Serviteur lo abandona, el efecto se desvanece gradualmente y el Baka suele buscar venganza. Cuesta 2 puntos de Fuerza de Voluntad y 2 puntos de Pathos, y concede 2 puntos temporales de Angustia. A discreción del Narrador, puede utilizarse sobre wraiths dominados por su Sombra." }] }
        ];

        // --- DISPLACE ---
        const displace = [
            { id: "displace000", source: ["wraith"], rank: 0, name: "Desplazar", description: "Este Arcanos pertenece a los Tvashtriya de Svarga y combina técnicas relacionadas con Kinesis, Moliate y Usury. Permite introducirse en el Corpus de otro wraith, manipularlo desde dentro y alterar su estructura.", system: [{ rank: 0, description: "Sistema: Cabalgar (Straddle) permite al Tvashtriya colocarse entre las capas del Corpus de otro wraith. Sentir Jinete (Sense Rider) permite detectar a un wraith que esté utilizando Cabalgar o Cabalgar Wraith sobre un huésped. La mecánica detallada de estas capacidades básicas no está especificada en la referencia consultada." }] },
            { id: "displace001", source: ["wraith"], rank: 1, name: "Cabalgar Wraith", description: "El Tvashtriya invade el Corpus de otro wraith y permanece dentro de él durante un periodo indefinido. No obtiene control sobre el huésped y comparte sus daños y peligros.", system: [{ rank: 1, description: "Sistema: Tira Sigilo + Desplazar para invadir el Corpus del objetivo. Una vez dentro, el huésped no percibe normalmente los acontecimientos externos desde la perspectiva del jinete, aunque este nota cuándo el huésped entra en Letargo. El jinete sufre también el daño que recibe el huésped, incluidos los efectos de una Tempestad o de un Harrowing. Otro jinete puede expulsarlo mediante una tirada enfrentada y debe superar los éxitos obtenidos por el primero. Sentir Jinete y Sentir Kinesis pueden detectar su presencia; un usuario de Usury también puede descubrirlo mediante una tirada de Inteligencia + Usury a dificultad 8." }] },
            { id: "displace002", source: ["wraith"], rank: 2, name: "Desviar", description: "El Tvashtriya oculta mejor su presencia dentro de un huésped y puede desviar parte del daño que este recibe hacia otro objetivo.", system: [{ rank: 2, description: "Sistema: Primero debes utilizar Cabalgar Wraith. Para evitar ser detectado, debes advertir que otro wraith está intentando localizarte y vencerlo en una tirada enfrentada de Inteligencia. Si tienes éxito, obtienes la ventaja en los siguientes enfrentamientos contra ese observador. Puedes gastar Pathos antes de una de esas tiradas para reducir en 1 por punto gastado la reserva Mental o Social del examinador. Para desviar daño, toca a un objetivo capaz de recibirlo y realiza una tirada enfrentada de Carisma. Con éxito, transfieres tantos niveles de daño como tu puntuación en Desplazar." }] },
            { id: "displace003", source: ["wraith"], rank: 3, name: "Transfusión", description: "El Tvashtriya transfiere Pathos entre su propio Corpus y el del huésped al que está cabalgando.", system: [{ rank: 3, description: "Sistema: Primero debes utilizar Cabalgar Wraith. Realiza una tirada enfrentada de Fuerza. Con éxito, puedes transferir 1 punto de Pathos más 1 punto adicional por cada Rasgo Físico que gastes. Robar Pathos cuesta 1 punto de Angustia; entregarlo no tiene coste adicional. El huésped percibe la transferencia si no está en Letargo." }] },
            { id: "displace004", source: ["wraith"], rank: 4, name: "Reconfigurar", description: "El Tvashtriya modifica la estructura del Corpus del huésped. Puede volverlo luminoso, transparente, conductor del sonido o remodelarlo como si utilizara Moliate.", system: [{ rank: 4, description: "Sistema: Primero debes utilizar Cabalgar Wraith. Gasta 1 punto de Pathos y obtén 1 punto de Angustia si el huésped consiente o 2 si se resiste. Realiza una tirada enfrentada de Inteligencia contra el huésped. Si tienes éxito, puedes comenzar a modificar su Corpus. Toda modificación cuesta al huésped 1 nivel de Corpus. Los cambios menores se realizan automáticamente; las transformaciones complejas, comparables a Esculpir de Moliate, requieren gastar un Rasgo Mental. Los cambios permanecen hasta que sean revertidos mediante Reconfigurar o Esculpir." }] },
            { id: "displace005", source: ["wraith"], rank: 5, name: "Transfigurar", description: "El maestro de Desplazar transforma el Corpus de su huésped en prácticamente cualquier forma, incluso en sustancias comestibles que contienen su Pathos.", system: [{ rank: 5, description: "Sistema: Primero debes utilizar Cabalgar Wraith. Gasta 2 puntos de Pathos y obtén 3 puntos de Angustia. Realiza una acción extendida enfrentada de Inteligencia contra el huésped. Un éxito permite realizar transformaciones generales; 3 o más éxitos permiten convertir al huésped en una forma comestible, como una pila de frutas en la que cada pieza contiene un Rasgo de su Pathos. Las transformaciones son permanentes." }] }
        ];

